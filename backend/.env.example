# Application Settings
APP_NAME=SecurityTest-AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to local SQLite fallback if MySQL is unreachable)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=sec_user
MYSQL_PASSWORD=sec_password
MYSQL_DATABASE=security_test_db

# Redis Memory (Falls back to in-memory dictionary if Redis is unreachable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Groq LLM Inference (Fallback heuristic synthesizer activates if key is absent)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Scan Configuration
MAX_CONCURRENT_SCANS=4
SCAN_TIMEOUT_SECONDS=300
DEFAULT_TARGET_PATH=../target_samples/vulnerable_app.py
